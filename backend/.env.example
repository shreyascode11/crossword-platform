# Copy this file to .env and fill in real values before running in production.

# Required: a long random secret — generate with: python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Set to True only during local development
DJANGO_DEBUG=False

# Comma-separated list of hosts that Django will serve (e.g. yourdomain.com,www.yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: set to True only for local dev; in production use CORS_ALLOWED_ORIGINS instead
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set True once served over HTTPS (enables SSL redirect, HSTS, secure cookies)
DJANGO_SECURE=False

# Session length and login lockout tuning
AUTH_TOKEN_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=900

# PostgreSQL database connection
DB_NAME=crossword
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Groq API keys for AI clue generation.
# Provide several so the platform can rotate across them and fail over when one
# hits its rate limit or runs out of quota — important under college-wide load.
# Slots 2 and 3 are optional; leave blank if you only have one key.
# (A comma-separated GROQ_API_KEYS=key1,key2,key3 also works.)
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_KEY_2=
GROQ_API_KEY_3=
