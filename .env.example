# Copy this file to .env and fill in real values, then run: docker compose up --build
# Docker Compose auto-loads .env from this directory.

# ── Secrets (required) ──────────────────────────────────────────────────────
# Password for the Postgres container's superuser (used by both db and backend)
POSTGRES_PASSWORD=change-me

# Django secret key — REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Groq API keys for AI clue generation. Provide several so the platform can
# rotate across them and fail over when one hits its rate limit — important
# under college-wide load. Slots 2 and 3 are optional.
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_KEY_2=
GROQ_API_KEY_3=


# ── Deployment (leave as-is for local; set these on the college server) ─────
# Hostnames Django will serve. Add your server's domain or IP.
#   example: ALLOWED_HOSTS=crossword.college.edu,10.0.0.15
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Where the browser reaches the API. BAKED INTO THE FRONTEND AT BUILD TIME —
# rebuild the frontend image after changing it:
#   docker compose up -d --build frontend
#   example: NEXT_PUBLIC_API_URL=https://crossword.college.edu/api/
NEXT_PUBLIC_API_URL=http://localhost:8000/api/

# Origins allowed to call the API (the frontend's public URL).
#   example: CORS_ALLOWED_ORIGINS=https://crossword.college.edu
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required by Django 4+ for POSTs when served over HTTPS (scheme included).
#   example: CSRF_TRUSTED_ORIGINS=https://crossword.college.edu
CSRF_TRUSTED_ORIGINS=

# Turn ON once the site is served over HTTPS. Enables SSL redirect, HSTS and
# secure cookies. Leave False for plain-HTTP/IP access or you will be locked out.
DJANGO_SECURE=False


# ── Auth tuning (optional) ──────────────────────────────────────────────────
# How long a login stays valid before re-authentication is required.
AUTH_TOKEN_TTL_HOURS=12
# Failed logins allowed per user+IP before a temporary lockout.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=900
